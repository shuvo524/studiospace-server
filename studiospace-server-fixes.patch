+
+async function seed() {
+  const db = await connectDB();
+  const collection = db.collection("studios");
+
+  let inserted = 0;
+  let updated = 0;
+
+  for (const studio of studios) {
+    const existing = await collection.findOne({ title: studio.title });
+    if (existing) {
+      await collection.updateOne(
+        { _id: existing._id },
+        {
+          $set: {
+            ...studio,
+            ownerName: existing.ownerName || HOST.ownerName,
+            ownerEmail: existing.ownerEmail || HOST.ownerEmail,
+            updatedAt: new Date(),
+          },
+        },
+      );
+      updated += 1;
+    } else {
+      await collection.insertOne({
+        ...studio,
+        ...HOST,
+        createdAt: new Date(),
+      });
+      inserted += 1;
+    }
+  }
+
+  const total = await collection.countDocuments();
+  console.log(
+    `Seed complete: ${inserted} inserted, ${updated} updated. Studios in database now: ${total}`,
+  );
+  process.exit(0);
+}
+
+seed().catch((error) => {
+  console.error("Seed failed:", error);
+  process.exit(1);
+});
